{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "packages/core/src/**/*",
      "packages/core/tests/**/*",
      "packages/miniprogram-otp/src/**/*",
      "packages/miniprogram-otp/tests/**/*",
      "packages/miniprogram-otp/scripts/**/*",
      "scripts/**/*",
      "*.json",
      "*.md",
      "packages/miniprogram-otp/AGENTS.md",
      "packages/miniprogram-otp/README.md",
      "packages/miniprogram-otp/README-cn.md",
      "packages/ohos-otp/AGENTS.md",
      "packages/ohos-otp/library/README.md",
      "packages/ohos-otp/library/README-cn.md",
      "packages/ohos-otp/library/example/README.md",
      ".agents/skills/**/*.md"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/otpauth-uri.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    }
  ]
}
